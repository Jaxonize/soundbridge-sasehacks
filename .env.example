# Optional: the checked-in defaults connect to the hackathon demo backend.
# Frontend values are public. Never put a Supabase secret or service-role key here.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Optional TURN servers for restrictive Wi-Fi / cellular NAT.
# For a public service, obtain short-lived TURN credentials from a server.
# VITE_ICE_SERVERS=[{"urls":"turn:YOUR_SERVER:3478","username":"TEMP_USERNAME","credential":"TEMP_CREDENTIAL"}]
